--// ลด HoldDuration สำหรับเกมของตัวเอง
local function setupPrompt(obj)
    if obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0
    end
end

for _, obj in ipairs(fencesFolder:GetDescendants()) do
    setupPrompt(obj)
end

fencesFolder.DescendantAdded:Connect(setupPrompt)

--// ค้นหา Fence และสุ่มลำดับ
local function getFences()
    local result = {}

    for _, obj in ipairs(fencesFolder:GetChildren()) do
        if obj.Name:match("^Fence%d+$") then
            table.insert(result, obj)
        end
    end

    -- Shuffle
    for i = #result, 2, -1 do
        local j = math.random(1, i)
        result[i], result[j] = result[j], result[i]
    end

    return result
end

--// กด E
local function pressE()
    VirtualInputManager:SendKeyEvent(
        true,
        Enum.KeyCode.E,
        false,
        game
    )

    task.wait(0.05)

    VirtualInputManager:SendKeyEvent(
        false,
        Enum.KeyCode.E,
        false,
        game
    )
end

--// วาร์ปแล้วกด E
local function moveToFence(fence)
    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not character or not humanoid or not root then
        return false
    end

    local part = fence:IsA("BasePart")
        and fence
        or fence:FindFirstChildWhichIsA("BasePart", true)

    if not part then
        return true
    end

    if not running then
        return false
    end

    -- Teleport
    character:PivotTo(
        part.CFrame * CFrame.new(0, 0, -3)
    )

    targetLabel.Text = "Target: " .. fence.Name

    task.wait(0.05)

    if not running then
        return false
    end

    -- Press E
    pressE()

    task.wait(delayTime)

    return running
end

--// START / STOP
startButton.MouseButton1Click:Connect(function()
    if running then
        running = false
        status.Text = "Status: STOPPING"
        return
    end

    running = true

    startButton.Text = "STOP"
    startButton.BackgroundColor3 =
        Color3.fromRGB(190, 55, 65)

    status.Text = "Status: RUNNING"

    task.spawn(function()
        while running do
            local fences = getFences()

            if #fences == 0 then
                status.Text = "No fences found"
                task.wait(1)
            else
                for _, fence in ipairs(fences) do
                    if not running then
                        break
                    end

                    status.Text = "Status: TELEPORTING"

                    if not moveToFence(fence) then
                        break
                    end
                end

                if running then
                    task.wait(0.1)
                end
            end
        end

        running = false

        startButton.Text = "START"
        startButton.BackgroundColor3 =
            Color3.fromRGB(40, 155, 95)

        status.Text = "Status: OFF"
    end)
end)

